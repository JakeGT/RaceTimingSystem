#  .env file example

#  Django settings
SECRET_KEY='-- insert django secret key here --'
SERVER_IP='-- insert server ip address here --'

#  Email settings
EMAIL_HOST_USER='-- insert gmail address here --'
EMAIL_HOST_PASSWORD='-- insert google app password here --'
DEFAULT_FROM_EMAIL='-- insert gmail address here --'

#  Google OAuth settings
GOOGLE_OAUTH_CLIENT_ID='-- insert google oauth client id here --'

#  Facebook settings
SOCIAL_AUTH_FACEBOOK_KEY='-- insert facebook key here --'
SOCIAL_AUTH_FACEBOOK_SECRET='-- insert facebook secret here --'

#  Github settings
SOCIAL_AUTH_GITHUB_KEY='-- insert github key here --'
SOCIAL_AUTH_GITHUB_SECRET='-- insert github secret here --'
