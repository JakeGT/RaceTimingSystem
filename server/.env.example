# Copy to server/.env for local development. Never commit .env.
SECRET_KEY=change-me-dev-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Leave unset to use SQLite (server/db.sqlite3); docker-compose sets Postgres.
# DATABASE_URL=postgres://racetiming:racetiming@localhost:5432/racetiming
# Where the React app is served. Links in invite and password-reset emails point here.
WEB_URL=http://localhost:5173
# Email: consolemail:// prints to the terminal. For real mail, e.g.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
