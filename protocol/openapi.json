{
  "components": {
    "schemas": {
      "AcceptIn": {
        "properties": {
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "title": "AcceptIn",
        "type": "object"
      },
      "AcceptOut": {
        "properties": {
          "account_created": {
            "title": "Account Created",
            "type": "boolean"
          },
          "organisation": {
            "title": "Organisation",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "organisation",
          "role",
          "account_created"
        ],
        "title": "AcceptOut",
        "type": "object"
      },
      "Candidate": {
        "properties": {
          "bib": {
            "pattern": "^[0-9A-Za-z-]{1,16}$",
            "title": "Bib",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "bib",
          "confidence"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "ClockIn": {
        "properties": {
          "client_sent_at": {
            "description": "Device clock when the request was sent (t0).",
            "format": "date-time",
            "title": "Client Sent At",
            "type": "string"
          }
        },
        "required": [
          "client_sent_at"
        ],
        "title": "ClockIn",
        "type": "object"
      },
      "ClockOut": {
        "description": "NTP-style exchange. With t3 = device clock when the response arrives:\noffset = ((t1 - t0) + (t2 - t3)) / 2 and round trip = (t3 - t0) - (t2 - t1).",
        "properties": {
          "client_sent_at": {
            "format": "date-time",
            "title": "Client Sent At",
            "type": "string"
          },
          "server_received_at": {
            "format": "date-time",
            "title": "Server Received At",
            "type": "string"
          },
          "server_sent_at": {
            "format": "date-time",
            "title": "Server Sent At",
            "type": "string"
          }
        },
        "required": [
          "client_sent_at",
          "server_received_at",
          "server_sent_at"
        ],
        "title": "ClockOut",
        "type": "object"
      },
      "DeviceConfig": {
        "properties": {
          "bibs": {
            "description": "Every bib entered in the event, for snapping reads.",
            "items": {
              "type": "string"
            },
            "title": "Bibs",
            "type": "array"
          },
          "capture_config": {
            "additionalProperties": true,
            "title": "Capture Config",
            "type": "object"
          },
          "config_version": {
            "description": "Changes whenever anything above changes.",
            "title": "Config Version",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/EventInfo"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "timing_point_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timing Point Id"
          },
          "timing_points": {
            "items": {
              "$ref": "#/components/schemas/TimingPointInfo"
            },
            "title": "Timing Points",
            "type": "array"
          }
        },
        "required": [
          "device_id",
          "name",
          "event",
          "timing_point_id",
          "timing_points",
          "capture_config",
          "bibs",
          "config_version",
          "server_time"
        ],
        "title": "DeviceConfig",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Error",
        "type": "object"
      },
      "EventInfo": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "start_date": {
            "title": "Start Date",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "timezone",
          "start_date"
        ],
        "title": "EventInfo",
        "type": "object"
      },
      "HeartbeatIn": {
        "properties": {
          "app_version": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          },
          "battery_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Pct"
          },
          "camera_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Ok"
          },
          "charging": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Charging"
          },
          "clock_offset_ms": {
            "anyOf": [
              {
                "maximum": 86400000,
                "minimum": -86400000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clock Offset Ms"
          },
          "clock_rtt_ms": {
            "anyOf": [
              {
                "maximum": 60000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clock Rtt Ms"
          },
          "fps": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          },
          "outbox_size": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outbox Size"
          },
          "temperature_c": {
            "anyOf": [
              {
                "maximum": 120,
                "minimum": -40,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature C"
          }
        },
        "title": "HeartbeatIn",
        "type": "object"
      },
      "HeartbeatOut": {
        "properties": {
          "config_version": {
            "title": "Config Version",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "server_time",
          "config_version"
        ],
        "title": "HeartbeatOut",
        "type": "object"
      },
      "InvitationIn": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "default": "volunteer"
          }
        },
        "required": [
          "email"
        ],
        "title": "InvitationIn",
        "type": "object"
      },
      "InvitationInfo": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "has_account": {
            "title": "Has Account",
            "type": "boolean"
          },
          "organisation": {
            "title": "Organisation",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "organisation",
          "role",
          "email",
          "has_account"
        ],
        "title": "InvitationInfo",
        "type": "object"
      },
      "InvitationOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "invited_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invited By"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expires_at",
          "invited_by"
        ],
        "title": "InvitationOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mfa_enabled": {
            "title": "Mfa Enabled",
            "type": "boolean"
          },
          "mfa_required": {
            "title": "Mfa Required",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organisations": {
            "items": {
              "$ref": "#/components/schemas/OrganisationRole"
            },
            "title": "Organisations",
            "type": "array"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "mfa_enabled",
          "mfa_required",
          "organisations"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MemberOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mfa_enabled": {
            "title": "Mfa Enabled",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "email",
          "name",
          "role",
          "mfa_enabled"
        ],
        "title": "MemberOut",
        "type": "object"
      },
      "ObservationBatchIn": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationIn"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          }
        },
        "required": [
          "observations"
        ],
        "title": "ObservationBatchIn",
        "type": "object"
      },
      "ObservationBatchOut": {
        "properties": {
          "accepted": {
            "description": "Stored now.",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Accepted",
            "type": "array"
          },
          "duplicates": {
            "description": "Already stored from an earlier upload: fine.",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Duplicates",
            "type": "array"
          },
          "rejected": {
            "description": "Won't be stored. Don't resend.",
            "items": {
              "$ref": "#/components/schemas/Rejection"
            },
            "title": "Rejected",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "ObservationBatchOut",
        "type": "object"
      },
      "ObservationIn": {
        "properties": {
          "candidates": {
            "description": "Best guess first. Empty if unreadable.",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "maxItems": 5,
            "title": "Candidates",
            "type": "array"
          },
          "captured_at_device": {
            "description": "Frame timestamp on the device clock, with timezone.",
            "format": "date-time",
            "title": "Captured At Device",
            "type": "string"
          },
          "clock_offset_ms": {
            "description": "Server time minus device time, as measured by the device.",
            "maximum": 86400000,
            "minimum": -86400000,
            "title": "Clock Offset Ms",
            "type": "integer"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "forward",
                  "reverse"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "id": {
            "description": "Generated on the device (UUIDv7 recommended). Idempotency key.",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "timing_point_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the device's assigned timing point.",
            "title": "Timing Point Id"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Id"
          }
        },
        "required": [
          "id",
          "captured_at_device",
          "clock_offset_ms"
        ],
        "title": "ObservationIn",
        "type": "object"
      },
      "OrganisationRole": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "role"
        ],
        "title": "OrganisationRole",
        "type": "object"
      },
      "PairIn": {
        "properties": {
          "app_version": {
            "default": "",
            "maxLength": 32,
            "title": "App Version",
            "type": "string"
          },
          "code": {
            "description": "Code from the pairing QR.",
            "maxLength": 32,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          },
          "name": {
            "description": "e.g. \"Finish - left tripod\".",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "platform": {
            "default": "",
            "description": "e.g. \"ios\" or \"android\".",
            "maxLength": 32,
            "title": "Platform",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "PairIn",
        "type": "object"
      },
      "PairOut": {
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/EventInfo"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "timing_point_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timing Point Id"
          },
          "token": {
            "description": "Send as `Authorization: Bearer <token>`. Shown once.",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "token",
          "event",
          "timing_point_id",
          "server_time"
        ],
        "title": "PairOut",
        "type": "object"
      },
      "PairingCodeIn": {
        "properties": {
          "timing_point_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timing Point Id"
          }
        },
        "title": "PairingCodeIn",
        "type": "object"
      },
      "PairingCodeOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "qr_payload": {
            "title": "Qr Payload",
            "type": "string"
          }
        },
        "required": [
          "code",
          "expires_at",
          "qr_payload"
        ],
        "title": "PairingCodeOut",
        "type": "object"
      },
      "Rejection": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "enum": [
              "no_timing_point",
              "timing_point_not_in_event",
              "in_future",
              "id_used_by_another_device"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "title": "Rejection",
        "type": "object"
      },
      "Role": {
        "enum": [
          "owner",
          "organiser",
          "volunteer"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleIn": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleIn",
        "type": "object"
      },
      "TimingPointIn": {
        "properties": {
          "timing_point_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timing Point Id"
          }
        },
        "required": [
          "timing_point_id"
        ],
        "title": "TimingPointIn",
        "type": "object"
      },
      "TimingPointInfo": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "TimingPointInfo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BrowserSessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      },
      "DeviceAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "XSessionTokenAuth": {
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Device protocol (see protocol/README.md) and the staff API. Staff sign in through allauth's headless API at /api/auth/ (session cookie or X-Session-Token).",
    "title": "Race Timing System API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/devices/me": {
      "get": {
        "operationId": "timing_api_get_config",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceConfig"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "summary": "Get this device's configuration",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/me/clock": {
      "post": {
        "operationId": "timing_api_clock",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "summary": "Clock sync exchange (NTP-style)",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/me/heartbeat": {
      "post": {
        "operationId": "timing_api_heartbeat",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "summary": "Report device health",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/me/observations/batch": {
      "post": {
        "operationId": "timing_api_upload_observations",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationBatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationBatchOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "summary": "Upload observations (idempotent: resending a batch is safe)",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/me/observations/{observation_id}/crop": {
      "post": {
        "operationId": "timing_api_upload_crop",
